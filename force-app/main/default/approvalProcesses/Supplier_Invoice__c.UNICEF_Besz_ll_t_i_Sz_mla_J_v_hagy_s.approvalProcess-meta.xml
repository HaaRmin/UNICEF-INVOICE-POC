<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Supplier_Name__c</field>
        <field>Gross_Amount__c</field>
        <field>Area__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Statusz_Penzugyi_igazgatoi_jovahagyasr</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Area_Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>1. Területvezetői jóváhagyás</label>
        <name>X1_Ter_letvezet_i_j_v_hagy_s</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>finance.unicef@unicefhungariannationalcommittee.hu</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Supplier_Invoice__c.Gross_Amount__c</field>
                <operation>greaterOrEqual</operation>
                <value>&quot;HUF 1,000,000&quot;</value>
            </criteriaItems>
        </entryCriteria>
        <label>2. Pénzügyi igazgatói jóváhagyás</label>
        <name>X2_P_nz_gyi_igazgat_i_j_v_hagy_s</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>NOT(ISBLANK(TEXT(Area__c)))</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>J_v_hagyva</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Elutas_tva</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Set_Status_to_TVJV</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>UNICEF Beszállítói Számla Jóváhagyás</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
